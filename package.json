{
  "name": "smart-subtitle-extension",
  "version": "0.14.0",
  "private": true,
  "description": "Local-first SRT/VTT/ASS subtitle extension for Chrome",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "demo": "node demo/server.js",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "pack:firefox": "node scripts/pack-firefox.mjs",
    "release:firefox": "node scripts/build-firefox.mjs && node scripts/pack-firefox.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
