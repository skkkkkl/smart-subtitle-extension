{
  "manifest_version": 3,
  "name": "本地字幕助手",
  "short_name": "本地字幕",
  "version": "0.12.2",
  "description": "在网页 HTML5 视频上加载 SRT/VTT/ASS 字幕，调整时间轴和字幕外观；文件默认只在本地处理。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*.opensubtitles.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开本地字幕面板（Alt+Shift+S）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开或收起本地字幕面板"
    }
  }
}
